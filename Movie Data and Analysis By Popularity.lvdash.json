{
  "datasets": [
    {
      "name": "a4c47a6e",
      "displayName": "Top Rated Popular Romantic Comedy Drama Movies Dataset",
      "queryLines": [
        "SELECT\r\n",
        "    md.original_title AS `Title`,\r\n",
        "    CASE md.original_language\r\n",
        "        WHEN 'en' THEN 'English'\r\n",
        "        WHEN 'hi' THEN 'Hindi'\r\n",
        "        WHEN 'fr' THEN 'French'\r\n",
        "        WHEN 'es' THEN 'Spanish'\r\n",
        "        WHEN 'ja' THEN 'Japanese'\r\n",
        "        WHEN 'ko' THEN 'Korean'\r\n",
        "        WHEN 'de' THEN 'German'\r\n",
        "        WHEN 'it' THEN 'Italian'\r\n",
        "        WHEN 'zh' THEN 'Chinese'\r\n",
        "        ELSE 'Other'\r\n",
        "    END AS Language,\r\n",
        "    md.genre AS `Genre`,\r\n",
        "    md.popularity AS `Popularity`,\r\n",
        "    md.vote_count AS `Vote Count`,\r\n",
        "    md.vote_average AS `Average Rating`\r\n",
        "   \r\n",
        "FROM movies_dataset md\r\n",
        "WHERE md.genre LIKE '%Comedy%'\r\n",
        "  AND md.genre LIKE '%Romance%'\r\n",
        "  AND md.genre LIKE '%Drama%'\r\n",
        "  AND md.popularity > 10 and md.vote_count > 1000 and md.vote_average > 7\r\n",
        "ORDER BY md.vote_average DESC;\r\n"
      ],
      "catalog": "datastore2026",
      "schema": "moviedata"
    },
    {
      "name": "3f722a10",
      "displayName": "Movie Ratings by Language and Genre with High Popularity",
      "queryLines": [
        "SELECT\r\n",
        "    CASE md.original_language\r\n",
        "        WHEN 'en' THEN 'English'\r\n",
        "        WHEN 'hi' THEN 'Hindi'\r\n",
        "        WHEN 'fr' THEN 'French'\r\n",
        "        WHEN 'es' THEN 'Spanish'\r\n",
        "        WHEN 'ja' THEN 'Japanese'\r\n",
        "        WHEN 'ko' THEN 'Korean'\r\n",
        "        WHEN 'de' THEN 'German'\r\n",
        "        WHEN 'it' THEN 'Italian'\r\n",
        "        WHEN 'zh' THEN 'Chinese'\r\n",
        "        ELSE 'Other'\r\n",
        "    END AS Language,\r\n",
        "    md.genre AS genre,\r\n",
        "    ROUND(AVG(md.popularity), 2) AS Rating\r\n",
        "FROM movies_dataset md\r\n",
        "WHERE md.original_language IS NOT NULL and md.popularity>10 and md.vote_count>100 and md.vote_average>7\r\n",
        "GROUP BY md.original_language,md.genre\r\n",
        "ORDER BY MAX(md.vote_average) DESC;\r\n"
      ],
      "catalog": "datastore2026",
      "schema": "moviedata"
    },
    {
      "name": "01199ab5",
      "displayName": "Recent Movie Titles and Details Dataset",
      "queryLines": [
        "SELECT\r\n",
        "    md.original_title AS Title,\r\n",
        "    CASE md.original_language\r\n",
        "        WHEN 'en' THEN 'English'\r\n",
        "        WHEN 'hi' THEN 'Hindi'\r\n",
        "        WHEN 'fr' THEN 'French'\r\n",
        "        WHEN 'es' THEN 'Spanish'\r\n",
        "        WHEN 'ja' THEN 'Japanese'\r\n",
        "        WHEN 'ko' THEN 'Korean'\r\n",
        "        WHEN 'de' THEN 'German'\r\n",
        "        WHEN 'it' THEN 'Italian'\r\n",
        "        WHEN 'zh' THEN 'Chinese'\r\n",
        "        ELSE 'Other'\r\n",
        "    END AS Language,\r\n",
        "    md.genre AS Genre,\r\n",
        "    md.release_date AS ReleaseDate,\r\n",
        "    YEAR(CURDATE()) - YEAR(md.release_date) AS Years\r\n",
        "FROM movies_dataset md\r\n",
        "WHERE md.release_date IS NOT NULL\r\n",
        "  AND YEAR(md.release_date) <= YEAR(CURDATE())\r\n",
        "LIMIT 10;\r\n"
      ],
      "catalog": "datastore2026",
      "schema": "moviedata"
    },
    {
      "name": "7c5b433f",
      "displayName": "Top Language by Movie Count Summary Dataset",
      "queryLines": [
        "SELECT\r\n",
        "    md.original_language AS Language,\r\n",
        "    COUNT(*) AS `Total Movies`\r\n",
        "FROM movies_dataset md\r\n",
        "GROUP BY md.original_language\r\n",
        "ORDER BY `Total Movies`  Desc LIMIT 1;\r\n"
      ],
      "catalog": "datastore2026",
      "schema": "moviedata"
    },
    {
      "name": "d77d898b",
      "displayName": "Highest Rated Movie Genre Overview",
      "queryLines": [
        "SELECT md.genre as Genre,ROUND(AVG(md.vote_average), 2) AS Rating FROM movies_dataset md GROUP BY md.genre ORDER BY Rating DESC LIMIT 1\r\n"
      ],
      "catalog": "datastore2026",
      "schema": "moviedata"
    },
    {
      "name": "37fbd56d",
      "displayName": "Top Movie by Popularity from Movies Dataset",
      "queryLines": [
        "SELECT original_title as Title, popularity as Popularity\r\n",
        "FROM movies_dataset\r\n",
        "ORDER BY popularity DESC\r\n",
        "LIMIT 1;\r\n"
      ],
      "catalog": "datastore2026",
      "schema": "moviedata"
    },
    {
      "name": "59f353a7",
      "displayName": "Movie Language Distribution and Percentage Breakdown",
      "queryLines": [
        "SELECT\r\n",
        "    original_language,\r\n",
        "    COUNT(*) AS `Movie Count`,\r\n",
        "    ROUND(\r\n",
        "        COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (),\r\n",
        "        2\r\n",
        "    ) AS `Percentage Share`\r\n",
        "FROM movies_dataset\r\n",
        "GROUP BY original_language\r\n",
        "ORDER BY `Movie Count` DESC limit 20;\r\n"
      ],
      "catalog": "datastore2026",
      "schema": "moviedata"
    },
    {
      "name": "91c6b37f",
      "displayName": "Top Twenty Genres Ranked by Average Movie Ratings",
      "queryLines": [
        "SELECT\r\n",
        "    TRIM(g.genre) AS Genre,\r\n",
        "    COUNT(*) AS `Movie Count`,\r\n",
        "    \r\n",
        "    ROUND(AVG(md.vote_average), 2) AS `Average Popularity`\r\n",
        "\r\n",
        "FROM movies_dataset md\r\n",
        "JOIN (\r\n",
        "    SELECT id, SUBSTRING_INDEX(SUBSTRING_INDEX(genre, ',', n.n), ',', -1) AS genre\r\n",
        "    FROM movies_dataset\r\n",
        "    JOIN (\r\n",
        "        SELECT 1 n UNION SELECT 2 UNION SELECT 3 UNION SELECT 4 UNION SELECT 5\r\n",
        "    ) n\r\n",
        "    ON CHAR_LENGTH(genre) - CHAR_LENGTH(REPLACE(genre, ',', '')) >= n.n - 1\r\n",
        ") g ON md.id = g.id\r\n",
        "GROUP BY g.genre\r\n",
        "ORDER BY  `Average Popularity` DESC LIMIT 20;\r\n"
      ],
      "catalog": "datastore2026",
      "schema": "moviedata"
    },
    {
      "name": "ac7b7285",
      "displayName": "Movie Ratings and Popularity Averages Dataset",
      "queryLines": [
        "SELECT\r\n",
        "    vote_average,\r\n",
        "    ROUND(AVG(popularity), 2) AS avg_popularity\r\n",
        "FROM movies_dataset\r\n",
        "WHERE vote_count > 500 and vote_average > 7\r\n",
        "GROUP BY vote_average\r\n",
        "ORDER BY vote_average DESC LIMIT 50;\r\n"
      ],
      "catalog": "datastore2026",
      "schema": "moviedata"
    }
  ],

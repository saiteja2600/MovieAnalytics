   "source": [
    "SELECT\n",
    "    original_language,\n",
    "    COUNT(*) AS `Movie Count`,\n",
    "    ROUND(\n",
    "        COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (),\n",
    "        2\n",
    "    ) AS `Percentage Share`\n",
    "FROM movies_dataset\n",
    "GROUP BY original_language\n",
    "ORDER BY `Movie Count` DESC;\n"
   ]
  }
